# LinkSec·AutoTest AI — 环境变量配置
# 复制本文件为 .env 并按需填写

# ── AI 引擎（可选）──────────────────────────────────────
# 不填则使用内置模拟分析模式，填写后启用真实 Claude AI 分析
ANTHROPIC_API_KEY=

# ── Flask ────────────────────────────────────────────────
FLASK_ENV=production

# ── SQLite 持久化（v3.3）─────────────────────────────────
# 数据快照落盘路径，默认 backend/data/linksec.db
LINKSEC_DB=./data/linksec.db
